# =============================================================================
# SignBank Environment Configuration
# Copy this file to .env and fill in your values: cp .env.example .env
# =============================================================================

# --- Application ---
BASE_URL=localhost
PORT=443

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=signbank
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/signbank
DATABASE_URL_DOCKER=postgresql://postgres:postgres@postgres:5432/signbank

# --- Admin bootstrap (only used when no admin exists in DB; local seed creates admin1–10) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
# Local dev login after seed: admin1@signbank.com / admin1123 (pattern admin{N}@signbank.com / admin{N}123)

# --- Typesense search engine ---
TYPESENSE_API_KEY=your-typesense-api-key-here
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108

# --- File server ---
FILE_SERVER_PATH=/production/FileServer
DUFS_URL=http://dufs:5000

# --- JWT authentication ---
JWT_SECRET=your-jwt-secret-here-min-32-chars-long
JWT_EXPIRATION=24h

# --- In-app backup (disabled by default; kartoza container handles DB dumps) ---
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *

# --- SSL (optional, for production) ---
# SSL_CERTIFICATE_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
# SSL_PRIVATE_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem
