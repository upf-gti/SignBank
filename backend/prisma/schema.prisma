generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN
    USER
}

enum RequestStatus {
    NOT_COMPLETED
    WAITING_FOR_APPROVAL
    ACCEPTED
    DENIED
}

enum Language {
    CATALAN
    SPANISH
    ENGLISH
    OTHER
}

enum LexicalCategory {
    ADJECTIVE
    INTERJECTION
    NOUN
    NOUN_OR_VERB
    NOUN_OR_ADJECTIVE
    NOUN_ADJECTIVE_OR_VERB
    VERB_OR_ADJECTIVE
    PARTICLE
    VERB
    ADVERB
    PRONOUN
    NOUN_ADJECTIVE_OR_ADVERB
    PARTICLE_NOUN_OR_VERB
    NOUN_OR_ADVERB
    VERB_ADJECTIVE_OR_ADVERB
    VERB_OR_INTERJECTION
    ADJECTIVE_OR_ADVERB
    VERB_ADJECTIVE_OR_PARTICLE
    PARTICLE_OR_ADJECTIVE
    NOUN_ADJECTIVE_OR_PARTICLE
    VERB_OR_ADVERB
    PARTICLE_OR_ADVERB
    NOUN_VERB_OR_ADVERB
    NOUN_OR_INTERJECTION
    ADVERB_OR_INTERJECTION
    VERB_OR_PARTICLE
    NOUN_OR_PREPOSITION
}

enum RelationType {
    SYNONYM
    REGIONAL_VARIANT
    ASSOCIATED_CONCEPT
    ANTONYM
    HOMONYM
    VARIANT
    HYPERNYM
    HYPONYM
}

enum GlossStatus {
    PUBLISHED
    ARCHIVED
}

enum EditStatus {
    PENDING
    APPROVED
    REJECTED
}

enum PhonologyDimension {
    HANDEDNESS
    HAND_CONFIGURATION
    CONFIGURATION_CHANGE
    RELATION_BETWEEN_ARTICULATORS
    LOCATION
    MOVEMENT_RELATED_ORIENTATION
    ORIENTATION_RELATED_TO_LOCATION
    ORIENTATION_CHANGE
    CONTACT_TYPE
    MOVEMENT_TYPE
    MOVEMENT_DIRECTION
}

model PhonologyValue {
    id             String              @id @default(uuid())
    dimension      PhonologyDimension
    code           String
    labelCa        String
    labelEn        String?
    labelEs        String?
    descriptionCa  String?
    descriptionEn  String?
    descriptionEs  String?
    aliases        String[]            @default([])
    sortOrder      Int                 @default(0)
    active         Boolean             @default(true)
    createdAt      DateTime            @default(now())
    updatedAt      DateTime            @updatedAt

    usedAsHandedness                         VideoData[] @relation("VideoHandedness")
    usedAsDominantConfiguration              VideoData[] @relation("VideoDominantConfiguration")
    usedAsNonDominantConfiguration           VideoData[] @relation("VideoNonDominantConfiguration")
    usedAsDominantRelationBetweenArticulators VideoData[] @relation("VideoDominantRelation")
    usedAsNonDominantRelationBetweenArticulators VideoData[] @relation("VideoNonDominantRelation")
    usedAsConfigurationChanges               VideoData[] @relation("VideoConfigurationChanges")
    usedAsLocation                           VideoData[] @relation("VideoLocation")
    usedAsMovementRelatedOrientation         VideoData[] @relation("VideoMovementRelatedOrientation")
    usedAsOrientationRelatedToLocation       VideoData[] @relation("VideoOrientationRelatedToLocation")
    usedAsOrientationChange                  VideoData[] @relation("VideoOrientationChange")
    usedAsContactType                        VideoData[] @relation("VideoContactType")
    usedAsMovementType                       VideoData[] @relation("VideoMovementType")
    usedAsMovementDirection                  VideoData[] @relation("VideoMovementDirection")

    @@unique([dimension, code])
    @@index([dimension, active])
}

model User {
    id               String         @id @default(uuid())
    username         String         @unique
    name             String
    lastName         String
    email            String         @unique
    password         String
    role             Role           @default(USER)
    createdAt        DateTime       @default(now())
    accessToken      String?
    refreshToken     String?
    glossRequests    GlossRequest[] @relation("Creator")
    acceptedRequests GlossRequest[] @relation("Acceptor")
    deniedRequests   GlossRequest[] @relation("Denier")
}

model DictionaryEntry {
    id                   String        @id @default(uuid())
    createdAt            DateTime      @default(now())
    updatedAt            DateTime      @updatedAt
    status               GlossStatus   @default(PUBLISHED)
    editComment          String?
    currentVersion       Int           @default(1)
    isCreatedFromRequest Boolean       @default(false)
    isCreatedFromEdit    Boolean       @default(false)
    glossRequest         GlossRequest? @relation(fields: [glossRequestId], references: [id])
    glossRequestId       String?       @unique
    glossData            GlossData     @relation(fields: [glossDataId], references: [id], onDelete: Cascade)
    glossDataId          String        @unique
}

model GlossData {
    id                   String             @id @default(uuid())
    gloss                String
    externalId           String?            @unique
    isCompound           Boolean            @default(false)
    iconicity            String?
    createdAt            DateTime           @default(now())
    updatedAt            DateTime           @updatedAt
    editComment          String?
    currentVersion       Int                @default(1)
    isCreatedFromRequest Boolean            @default(false)
    isCreatedFromEdit    Boolean            @default(false)
    dictionaryEntry      DictionaryEntry?
    glossRequest         GlossRequest?
    glossVideos          SignVideo[]
    definitions          Definition[]
    examples             Example[]
    glossTranslations    GlossTranslation[]
    compoundParts        CompoundPart[]
    usedInCompounds      CompoundPart[]     @relation("CompoundPartLinkedGloss")
    relationsAsSource    RelatedGloss[]     @relation("RelationSource")
    relationsAsTarget    RelatedGloss[]     @relation("RelationTarget")
    minimalPairsAsSource MinimalPair[]      @relation("MinimalPairSource")
    minimalPairsAsTarget MinimalPair[]      @relation("MinimalPairTarget")
}

model CompoundPart {
    id                String     @id @default(uuid())
    glossDataId       String
    glossData         GlossData  @relation(fields: [glossDataId], references: [id], onDelete: Cascade)
    position          Int
    gloss             String
    compExternalId    String?
    linkedGlossId     String?
    linkedGloss       GlossData? @relation("CompoundPartLinkedGloss", fields: [linkedGlossId], references: [id])
    redundant         Boolean    @default(false)
    inlinePhonologyId String?    @unique
    inlinePhonology   VideoData? @relation("CompoundPartInlinePhonology", fields: [inlinePhonologyId], references: [id], onDelete: Cascade)
    inlineSignVideoId String?    @unique
    inlineSignVideo   SignVideo? @relation("CompoundPartInlineSignVideo", fields: [inlineSignVideoId], references: [id], onDelete: SetNull)

    @@unique([glossDataId, position])
}

model RelatedGloss {
    id            String       @id @default(uuid())
    relationType  RelationType
    sourceGloss   GlossData    @relation("RelationSource", fields: [sourceGlossId], references: [id])
    sourceGlossId String
    targetGloss   GlossData    @relation("RelationTarget", fields: [targetGlossId], references: [id])
    targetGlossId String

    @@unique([sourceGlossId, targetGlossId])
}

model GlossTranslation {
    id          String    @id @default(uuid())
    translation String
    language    Language
    glossData   GlossData @relation(fields: [glossDataId], references: [id], onDelete: Cascade)
    glossDataId String
}

model Definition {
    id                     String                  @id @default(uuid())
    title                  String?
    definition             String
    lexicalCategory        LexicalCategory         @default(NOUN)
    definitionTranslations DefinitionTranslation[]
    videoDefinitionUrl     String?
    glossData              GlossData               @relation(fields: [glossDataId], references: [id], onDelete: Cascade)
    glossDataId            String
    priority               Int                     @default(0)
}

model Example {
    id                  String               @id @default(uuid())
    example             String
    exampleVideoURL     String
    glossData           GlossData            @relation(fields: [glossDataId], references: [id], onDelete: Cascade)
    glossDataId         String
    exampleTranslations ExampleTranslation[]
}

model ExampleTranslation {
    id          String   @id @default(uuid())
    translation String
    language    Language
    Example     Example? @relation(fields: [exampleId], references: [id], onDelete: Cascade)
    exampleId   String?
}

model DefinitionTranslation {
    id           String     @id @default(uuid())
    translation  String
    language     Language
    definition   Definition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
    definitionId String
}

model SignVideo {
    id                 String        @id @default(uuid())
    title              String
    videos             Video[]
    priority           Int           @default(0)
    videoData          VideoData     @relation(fields: [videoDataId], references: [id], onDelete: Cascade)
    videoDataId        String
    glossData          GlossData?    @relation(fields: [glossDataId], references: [id], onDelete: Cascade)
    glossDataId        String?
    compoundPartInline CompoundPart? @relation("CompoundPartInlineSignVideo")
}

model VideoData {
    handednessId                             String?
    handedness                               PhonologyValue?            @relation("VideoHandedness", fields: [handednessId], references: [id], onDelete: SetNull)
    dominantConfigurationId                  String?
    dominantConfiguration                    PhonologyValue?            @relation("VideoDominantConfiguration", fields: [dominantConfigurationId], references: [id], onDelete: SetNull)
    nonDominantConfigurationId               String?
    nonDominantConfiguration                 PhonologyValue?            @relation("VideoNonDominantConfiguration", fields: [nonDominantConfigurationId], references: [id], onDelete: SetNull)
    dominantRelationBetweenArticulatorsId    String?
    dominantRelationBetweenArticulators      PhonologyValue?            @relation("VideoDominantRelation", fields: [dominantRelationBetweenArticulatorsId], references: [id], onDelete: SetNull)
    nonDominantRelationBetweenArticulatorsId String?
    nonDominantRelationBetweenArticulators   PhonologyValue?            @relation("VideoNonDominantRelation", fields: [nonDominantRelationBetweenArticulatorsId], references: [id], onDelete: SetNull)
    configurationChangesId                   String?
    configurationChanges                     PhonologyValue?            @relation("VideoConfigurationChanges", fields: [configurationChangesId], references: [id], onDelete: SetNull)
    locationId                               String?
    location                                 PhonologyValue?            @relation("VideoLocation", fields: [locationId], references: [id], onDelete: SetNull)
    movementRelatedOrientationId             String?
    movementRelatedOrientation               PhonologyValue?            @relation("VideoMovementRelatedOrientation", fields: [movementRelatedOrientationId], references: [id], onDelete: SetNull)
    orientationRelatedToLocationId           String?
    orientationRelatedToLocation             PhonologyValue?            @relation("VideoOrientationRelatedToLocation", fields: [orientationRelatedToLocationId], references: [id], onDelete: SetNull)
    orientationChangeId                      String?
    orientationChange                        PhonologyValue?            @relation("VideoOrientationChange", fields: [orientationChangeId], references: [id], onDelete: SetNull)
    contactTypeId                            String?
    contactType                              PhonologyValue?            @relation("VideoContactType", fields: [contactTypeId], references: [id], onDelete: SetNull)
    movementTypeId                           String?
    movementType                             PhonologyValue?            @relation("VideoMovementType", fields: [movementTypeId], references: [id], onDelete: SetNull)
    movementDirectionId                      String?
    movementDirection                        PhonologyValue?            @relation("VideoMovementDirection", fields: [movementDirectionId], references: [id], onDelete: SetNull)
    vocalization                             String
    nonManualComponent                       String
    inicialization                           String
    repeatedMovement                         Boolean                    @default(false)
    signVideo                                SignVideo[]
    compoundPart                             CompoundPart?              @relation("CompoundPartInlinePhonology")
    id                                       String                     @id @default(uuid())
}

model Video {
    id          String    @id @default(uuid())
    url         String
    angle       String
    priority    Int       @default(0)
    signVideo   SignVideo @relation(fields: [signVideoId], references: [id], onDelete: Cascade)
    signVideoId String
}

model MinimalPair {
    id            String    @id @default(uuid())
    distinction   String
    sourceGloss   GlossData @relation("MinimalPairSource", fields: [sourceGlossId], references: [id])
    sourceGlossId String
    targetGloss   GlossData @relation("MinimalPairTarget", fields: [targetGlossId], references: [id])
    targetGlossId String

    @@unique([sourceGlossId, targetGlossId])
}

model GlossRequest {
    id                   String           @id @default(uuid())
    creator              User             @relation("Creator", fields: [creatorId], references: [id])
    creatorId            String
    status               RequestStatus    @default(NOT_COMPLETED)
    createdAt            DateTime         @default(now())
    updatedAt            DateTime         @updatedAt
    lastEditedSection    String? // Tracks which section was last edited (e.g. "definitions", "examples", etc.)
    denyReason           String?
    acceptedBy           User?            @relation("Acceptor", fields: [acceptedById], references: [id])
    acceptedById         String?
    deniedBy             User?            @relation("Denier", fields: [deniedById], references: [id])
    deniedById           String?
    requestedGlossData   GlossData        @relation(fields: [requestedGlossDataId], references: [id], onDelete: Cascade)
    requestedGlossDataId String           @unique
    glossId              String?
    dictionaryEntry      DictionaryEntry?
}
