{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "import/**/*.json",
        "watchAssets": true
      },
      {
        "include": "phonology-values/**/*.json",
        "watchAssets": true
      }
    ]
  }
}
